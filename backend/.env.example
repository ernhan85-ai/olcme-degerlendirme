LEARNDNA_ENV=development
LEARNDNA_DATABASE_URL=postgresql+psycopg://learndna:learndna@localhost:5432/learndna
LEARNDNA_REDIS_URL=redis://localhost:6379/0
LEARNDNA_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes
# inline | celery
LEARNDNA_TASK_BACKEND=inline
# local | s3 (s3 adapter not implemented yet)
LEARNDNA_STORAGE_BACKEND=local
LEARNDNA_LOCAL_STORAGE_DIR=./var/uploads
LEARNDNA_MAX_UPLOAD_MB=40
# none | clamav
LEARNDNA_MALWARE_SCANNER=none
LEARNDNA_CLAMAV_HOST=localhost
LEARNDNA_CLAMAV_PORT=3310
# AI providers: mock works without credentials (clearly labelled SİMÜLASYON in UI)
# mock | openai_compatible
LEARNDNA_VISION_PROVIDER=mock
# mock | openai_compatible
LEARNDNA_LLM_PROVIDER=mock
LEARNDNA_OPENAI_BASE_URL=
LEARNDNA_OPENAI_API_KEY=
LEARNDNA_OPENAI_VISION_MODEL=
LEARNDNA_OPENAI_TEXT_MODEL=
LEARNDNA_OCR_MIN_CONFIDENCE=0.60
LEARNDNA_REVIEW_CONFIDENCE_THRESHOLD=0.70
